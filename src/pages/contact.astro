---
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';

const address = '24 Logiealmond Close, Unit 24, Dartmouth, NS B3B 0C8';
const mapQuery = encodeURIComponent('24 Logiealmond Close, Dartmouth, NS B3B 0C8');
const office = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateAgent',
  name: 'Century 21 Optimum Realty',
  telephone: '+1-902-444-1333',
  image: 'https://realestatecareerns.ca/media/century-21-optimum-realty-office-dartmouth.jpg',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '24 Logiealmond Close, Unit 24',
    addressLocality: 'Dartmouth',
    addressRegion: 'NS',
    postalCode: 'B3B 0C8',
    addressCountry: 'CA',
  },
};
---
<Base
  title="Talk to Rob"
  description="Questions about a real estate career in Nova Scotia? Contact Rob Lough, Broker/Owner of Century 21 Optimum Realty. Conversations are confidential."
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Contact', url: '/contact/' }]}
>
  <script type="application/ld+json" set:html={JSON.stringify(office)} />
  <section class="section">
    <div class="wrap">
      <LeadForm
        heading="Talk to Rob"
        intro="Whether you’re thinking about getting licensed or already licensed somewhere else, send a note. Conversations are confidential."
      />
    </div>
  </section>

  <section class="section">
    <div class="wrap office">
      <figure class="office-photo">
        <img src="/media/century-21-optimum-realty-office-dartmouth.jpg" width="1200" height="1600" loading="lazy"
          alt="The Century 21 Optimum Realty office at 24 Logiealmond Close in Dartmouth, with a Now Hiring sign out front" />
      </figure>
      <div class="office-info">
        <h2>Visit the office</h2>
        <p><strong>Century 21 Optimum Realty</strong><br />{address}</p>
        <p><a href="tel:+19024441333">902-444-1333</a></p>
        <p>If you’d rather talk in person, send a note above and we’ll set a time.</p>
        <iframe class="office-map" title="Map to Century 21 Optimum Realty, 24 Logiealmond Close, Dartmouth"
          src={`https://maps.google.com/maps?q=${mapQuery}&z=15&output=embed`} loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
        <p><a href={`https://www.google.com/maps/dir/?api=1&destination=${mapQuery}`}>Get directions</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .office { display: grid; gap: var(--space); grid-template-columns: 1fr; align-items: start; }
  @media (min-width: 760px) { .office { grid-template-columns: 2fr 3fr; } }
  .office-photo { margin: 0; }
  .office-photo img { width: 100%; height: auto; border-radius: 4px; display: block; }
  .office-info h2 { margin-top: 0; }
  .office-map { width: 100%; height: 320px; border: 1px solid var(--line); border-radius: 4px; }
</style>
