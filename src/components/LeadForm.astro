---
// The site-wide "Career Site Inquiry" GoHighLevel form (C21 Optimum sub-account).
// Workflow "Career Site: Inquiry" tags career-site + career-inquiry, emails Rob,
// tags the stage from "What best describes you?" and texts Rob for licensed-and-looking.
// GHL records the page each submission came from. See kb/ghl-forms.md.
import GhlForm from './GhlForm.astro';
interface Props { heading: string; intro: string; }
const { heading, intro } = Astro.props;
---
<section class="lead" aria-label={heading}>
  <h2>{heading}</h2>
  <p>{intro}</p>
  <GhlForm formId="xdCbAXJeaRoZ3NLSxI0z" formName="Career Site Inquiry" height={760} />
</section>
