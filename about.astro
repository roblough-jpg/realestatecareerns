---
import Base from '../layouts/Base.astro';
import { AUTHOR, SITE } from '../consts';
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: AUTHOR.name,
  jobTitle: AUTHOR.jobTitle,
  url: AUTHOR.url,
  sameAs: AUTHOR.sameAs,
  worksFor: { '@id': 'https://optimumrealty.c21.ca/#org' },
  knowsAbout: ['Nova Scotia real estate licensing', 'Real estate brokerage', 'Home inspection', 'FINTRAC compliance'],
};
---
<Base
  title="About Rob Lough"
  description="Rob Lough is the Broker/Owner of Century 21 Optimum Realty, with 25 years in Nova Scotia real estate and five years as a certified home inspector."
  schema={[person]}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'About Rob Lough', url: '/about/' }]}
>
  <section class="article-head">
    <div class="wrap prose">
      <h1>About Rob Lough</h1>
      <p class="byline">{AUTHOR.jobTitle}</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap prose">
      <p>{AUTHOR.bio}</p>
      <p>Before running a brokerage, Rob spent five years as a certified home inspector. That background shapes how he trains agents: know the house, know the paperwork, and give clients straight answers.</p>
      <p>He built {SITE.name} because people considering this career deserve honest information about the money, the hours and the first year, not a sales pitch. Agents already in the business get the same: practical answers about splits, compliance and the tools that save time.</p>
      <p>Rob also built BrokerageFlow, the compliance and deal file system his agents use every day.</p>
      <p><a class="btn" href="/contact/">Talk to Rob</a></p>
    </div>
  </section>
</Base>
