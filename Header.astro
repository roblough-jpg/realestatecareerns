---
import { SITE } from '../consts';
const path = Astro.url.pathname;
const links = [
  { href: '/getting-licensed/', label: 'Getting licensed' },
  { href: '/growing-your-career/', label: 'Growing your career' },
  { href: '/tools/licensing-cost-calculator/', label: 'Cost calculator' },
  { href: '/blog/', label: 'All answers' },
];
---
<header class="site-header">
  <div class="wrap header-row">
    <a class="brand" href="/">
      <span class="brand-name">{SITE.name}</span>
      <span class="brand-by">Presented by {SITE.presentedBy}</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <a class="btn btn-small" href="/contact/">Talk to Rob</a>
  </div>
</header>
